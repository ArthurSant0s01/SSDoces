# Supabase configuration
# Replace these placeholders locally. Never commit real credentials.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only. NEVER expose this value in browser code or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public site URL
VITE_SITE_URL=https://example.com

# Server-side email configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Store Name <noreply@example.com>
SSDOCES_ADMIN_EMAIL=admin@example.com
